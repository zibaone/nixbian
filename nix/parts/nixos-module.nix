self:
{
  config,
  lib,
  options,
  pkgs,
  ...
}:

let
  cfg = config.hardware.nixbian;

  # Effective kernel configuration mode.
  # `configType` is DEPRECATED and only serves as a fallback when the user
  # did not define `configMode`: any definition of `configMode` (even
  # `mkDefault`) has a better priority than the option default injected by
  # the module system (`mkOptionDefault` = `mkOverride 1500`, cf. lib/modules.nix).
  # Fallback mapping: minimal -> defconfig, armbian -> armbian.
  # If the user defined nothing, the default is picked from the data
  # (armbian if an Armbian config was collected for the family, otherwise nixpkgs).
  effectiveConfigMode =
    if options.hardware.nixbian.configMode.highestPrio == 1500 then
      if cfg.configType != null then
        (if cfg.configType == "minimal" then "defconfig" else cfg.configType)
      else
        defaultConfigMode
    else
      cfg.configMode;

  # Load library from the nixbian metadata
  armbianLib = self.lib.loadMetadata pkgs (self + "/metadata");
  helpers = armbianLib.helpers;

  # Load sources from nvfetcher
  sources = pkgs.callPackage (self + "/metadata/sources/generated.nix") { };

  # Inject source derivations from nvfetcher into metadata
  injectHashes =
    meta:
    let
      kSourceKey = meta.kernel.nvfetcher_key or null;
      uSourceKey = meta.uboot.nvfetcher_key or null;
      aSourceKey = meta.uboot.atf_nvfetcher_key or null;
      fSourceKey = meta.firmware.nvfetcher_key or null;

      kSource = if kSourceKey != null then sources.${kSourceKey} or null else null;
      uSource = if uSourceKey != null then sources.${uSourceKey} or null else null;
      aSource = if aSourceKey != null then sources.${aSourceKey} or null else null;
      fSource = if fSourceKey != null then sources.${fSourceKey} or null else null;
    in
    lib.recursiveUpdate meta {
      kernel.src = if kSource != null then kSource.src else null;
      uboot.src = if uSource != null then uSource.src else null;
      uboot.atf_src = if aSource != null then aSource.src else null;
      firmware.src = if fSource != null then fSource.src else null;
    };

  # Find board info.
  # Match the boardKey generated by Nixbian (board-branch)
  boardKey = "${cfg.board}-${cfg.kernelVendor}";

  # Fetch board data.
  rawBoardData = armbianLib.platforms.${boardKey} or null;
  boardData = if rawBoardData != null then injectHashes rawBoardData else null;

  # An Armbian config only exists if the generator collected one for the
  # family: otherwise the "armbian" tier would apply an empty config and the
  # default mode must fall back to nixpkgs (common config) to stay bootable.
  hasArmbianConfig =
    boardData != null
    && ((boardData.kernel or { }) ? config_path_nix)
    && (boardData.kernel.config_path_nix or null) != null;

  defaultConfigMode = if hasArmbianConfig then "armbian" else "nixpkgs";

  family =
    if boardData != null && boardData ? linux_family && boardData.linux_family != null then
      boardData.linux_family
    else
      "generic";

  familyPkgFile = self + "/metadata/nix/families/${family}/package.nix";
  familyPackages =
    if builtins.pathExists familyPkgFile then
      import familyPkgFile { inherit pkgs helpers sources; }
    else
      { };

  # Load firmware helper
  fwLib = import (self + "/metadata/nix/firmware.nix") { inherit pkgs; };

  # Patch Pipeline
  rawPatches =
    if boardData != null then helpers.getPatches (boardData.kernel.patches or [ ]) else [ ];
  filteredPatches = lib.filter (
    p:
    let
      name = builtins.baseNameOf p;
    in
    !(lib.any (re: builtins.match re name != null) cfg.excludePatchPatterns)
  ) rawPatches;
  finalPatches = filteredPatches ++ cfg.extraPatches;

  # GPIO Configurator Command Helper
  makeGpiosetCmd =
    name: pinCfg:
    let
      lineId = if pinCfg.line != null then toString pinCfg.line else name;
      biasArg =
        if pinCfg.bias == "pullup" then
          "--bias pull-up"
        else if pinCfg.bias == "pulldown" then
          "--bias pull-down"
        else if pinCfg.bias == "disabled" then
          "--bias disabled"
        else
          "";
      activeLowArg = if pinCfg.activeLow then "--active-low" else "";
      driveArg = if pinCfg.drive != "push-pull" then "--drive ${pinCfg.drive}" else "";
      val = if pinCfg.initialValue != null then toString pinCfg.initialValue else "0";
      chipArg = if pinCfg.line != null then "--chip ${toString pinCfg.chip}" else "";
    in
    if pinCfg.direction == "out" then
      "${pkgs.libgpiod}/bin/gpioset ${chipArg} ${biasArg} ${activeLowArg} ${driveArg} ${lineId}=${val}"
    else
      "${pkgs.libgpiod}/bin/gpiomon --quiet ${chipArg} ${biasArg} ${activeLowArg} ${lineId}";

  # I2C Overlay Helper
  i2cOverlay = lib.optional (cfg.i2c.buses != [ ]) {
    name = "nixbian-i2c";
    dtsFile = pkgs.writeText "nixbian-i2c.dts" ''
      /dts-v1/;
      /plugin/;

      ${lib.concatMapStringsSep "\n" (b: ''
        &i2c${toString b.bus} {
          status = "okay";
          ${lib.optionalString (
            b.clockFrequency != null
          ) "clock-frequency = <${toString b.clockFrequency}>;"}
        };
      '') cfg.i2c.buses}
    '';
  };

  # SPI Overlay Helper
  spiOverlay = lib.optional (cfg.spi.buses != [ ]) {
    name = "nixbian-spi";
    dtsFile = pkgs.writeText "nixbian-spi.dts" ''
      /dts-v1/;
      /plugin/;

      ${lib.concatMapStringsSep "\n" (b: ''
        &spi${toString b.bus} {
          status = "okay";
        };
      '') cfg.spi.buses}
    '';
  };

in
{
  options.hardware.nixbian = {
    enable = lib.mkEnableOption "Nixbian Hardware Engine";

    board = lib.mkOption {
      type = lib.types.str;
      description = "Armbian board identifier (e.g., 'orangepizero3')";
    };

    family = lib.mkOption {
      type = lib.types.str;
      default = "generic";
      description = "Auto-detected Linux family (can be overridden)";
    };

    configMode = lib.mkOption {
      type = lib.types.enum [
        "nixpkgs"
        "defconfig"
        "armbian"
      ];
      default = "armbian";
      description = ''
        Kernel configuration mode:

        - `nixpkgs`: common nixpkgs config (enableCommonConfig) + `extraConfig`.
        - `defconfig`: defconfig + family fragment + `extraConfig` (fast build, ~5 min).
        - `armbian`: full Armbian config applied as-is (default, ~60 min).
      '';
    };

    extraConfig = lib.mkOption {
      type = lib.types.lines;
      default = "";
      description = ''
        Additional `.config` fragment (syntax `CONFIG_X=y`), concatenated after the
        selected mode's config, regardless of `configMode`. `types.lines` so that
        several definitions merge instead of one silently overriding the others:
        a producer can use `mkAfter` and a consumer cannot drop its lines.
      '';
    };

    configType = lib.mkOption {
      type = lib.types.nullOr (
        lib.types.enum [
          "minimal"
          "armbian"
        ]
      );
      default = null;
      description = ''
        DEPRECATED: use `hardware.nixbian.configMode` instead.

        Old name of the kernel configuration mode. If set, it is used as a fallback
        when `configMode` is not set: `minimal` -> `defconfig`, `armbian` -> `armbian`.
      '';
    };

    kernelVendor = lib.mkOption {
      type = lib.types.str;
      default = "current";
      description = "Armbian kernel series to use (default: current)";
    };

    kernelModules = {
      prune = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = ''
          Prunes the embedded modules tree (L5): only the core, the board DTB
          compatibles and the allowlist are kept. Cheap derivation on the shared
          tree — the kernel is not rebuilt.
        '';
      };
      full = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = ''
          Escape hatch: keeps the full modules tree (exotic USB hotplug,
          debugging). Takes precedence over `kernelModules.prune`.
        '';
      };
      extraKeep = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        description = ''
          Module names (kmod, dashes or underscores) to keep in addition to the
          policy. `boot.kernelModules` is added automatically.
        '';
      };
    };

    uBoot = {
      package = lib.mkOption {
        type = lib.types.nullOr lib.types.package;
        default = null;
        description = "The selected U-Boot package (defaults to Nixbian/Vendor if available)";
      };
      useUpstream = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Whether to use upstream U-Boot (from denx.de) instead of the vendor (Armbian) version";
      };
    };

    excludePatchPatterns = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        ".*armbian-config.*"
        ".*logo.*"
      ];
      description = "Regex patterns of patches to exclude from Armbian source";
    };

    extraPatches = lib.mkOption {
      type = lib.types.listOf lib.types.path;
      default = [ ];
      description = "Additional patches to apply to the kernel";
    };

    pruneFirmware = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Prune the firmware package to only include driver blobs matching compatible devices in the board DTB.";
    };

    compressFirmware = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Compress firmware blobs using ZSTD (automatically checked against kernel CONFIG_FW_LOADER_COMPRESS).";
    };

    overlays = lib.mkOption {
      type = lib.types.listOf (
        lib.types.coercedTo lib.types.path (dtsFile: {
          name = builtins.baseNameOf dtsFile;
          inherit dtsFile;
        }) lib.types.attrs
      );
      default = [ ];
      description = "List of custom Device Tree overlays (.dts or .dtbo files) to compile and apply.";
    };

    security = {
      harden = lib.mkOption {
        type = lib.types.bool;
        default = false;
        description = "Enable recommended network and kernel hardening parameters for edge SBC deployments.";
      };
    };

    sdCard = {
      wearMitigation = {
        enable = lib.mkOption {
          type = lib.types.bool;
          default = true;
          description = "Reduce flash wear by enabling tmpfs for /tmp, memory journal storage, and zram swap.";
        };
      };
    };

    gpio = {
      pins = lib.mkOption {
        type = lib.types.attrsOf (
          lib.types.submodule {
            options = {
              chip = lib.mkOption {
                type = lib.types.int;
                default = 0;
                description = "GPIO chip number (e.g. 0 for gpiochip0).";
              };
              line = lib.mkOption {
                type = lib.types.nullOr lib.types.int;
                default = null;
                description = "GPIO line offset on the chip. If null, the attribute key is used as the line name.";
              };
              direction = lib.mkOption {
                type = lib.types.enum [
                  "in"
                  "out"
                ];
                default = "in";
                description = "Pin direction ('in' or 'out').";
              };
              activeLow = lib.mkOption {
                type = lib.types.bool;
                default = false;
                description = "Whether the pin is active-low.";
              };
              bias = lib.mkOption {
                type = lib.types.enum [
                  "pullup"
                  "pulldown"
                  "disabled"
                  "none"
                ];
                default = "none";
                description = "Pin bias ('pullup', 'pulldown', 'disabled', or 'none').";
              };
              drive = lib.mkOption {
                type = lib.types.enum [
                  "push-pull"
                  "open-drain"
                  "open-source"
                ];
                default = "push-pull";
                description = "Pin drive mode ('push-pull', 'open-drain', or 'open-source').";
              };
              initialValue = lib.mkOption {
                type = lib.types.nullOr (
                  lib.types.enum [
                    0
                    1
                  ]
                );
                default = null;
                description = "Initial output value (0 or 1). Only relevant if direction is 'out'.";
              };
            };
          }
        );
        default = { };
        description = "Declarative configuration of GPIO pins.";
      };
    };

    i2c = {
      buses = lib.mkOption {
        type = lib.types.listOf (
          lib.types.coercedTo lib.types.int (bus: { inherit bus; }) (
            lib.types.submodule {
              options = {
                bus = lib.mkOption {
                  type = lib.types.int;
                  description = "I2C bus number (e.g. 0 for i2c0).";
                };
                clockFrequency = lib.mkOption {
                  type = lib.types.nullOr lib.types.int;
                  default = null;
                  description = "Clock frequency of the bus in Hz (e.g. 400000 for 400kHz).";
                };
              };
            }
          )
        );
        default = [ ];
        description = "List of I2C buses to enable and configure.";
      };
    };

    spi = {
      buses = lib.mkOption {
        type = lib.types.listOf (
          lib.types.coercedTo lib.types.int (bus: { inherit bus; }) (
            lib.types.submodule {
              options = {
                bus = lib.mkOption {
                  type = lib.types.int;
                  description = "SPI bus number (e.g. 0 for spi0).";
                };
              };
            }
          )
        );
        default = [ ];
        description = "List of SPI buses to enable and configure.";
      };
    };
  };

  config = lib.mkIf (cfg.enable && boardData != null) {
    # 0. L5 — pruning of the bundled modules tree.
    # The filter starts from the EFFECTIVE kernel (boot.kernelPackages.kernel),
    # so it stays correct whatever tier/mode the host selected. Keep-list:
    # names from boot.kernelModules + packages from boot.extraModulePackages
    # (the initrd already computes its own closure).
    system.modulesTree =
      lib.mkIf (cfg.kernelModules.prune && !cfg.kernelModules.full && (boardData.dtb or null) != null)
        (
          lib.mkForce (
            [
              (helpers.pruneKernelModules {
                name = "linux-modules-${boardKey}-pruned";
                kernelOut = config.boot.kernelPackages.kernel;
                modules = config.boot.kernelPackages.kernel.modules;
                dtb = "${config.boot.kernelPackages.kernel}/dtbs/${boardData.dtb}";
                extraKeep = cfg.kernelModules.extraKeep ++ config.boot.kernelModules;
                extraKeepPaths = config.boot.extraModulePackages;
              })
            ]
            ++ config.boot.extraModulePackages
          )
        );

    # 1. Kernel Configuration
    boot.kernelPackages = lib.mkDefault (
      pkgs.linuxPackagesFor (
        helpers.buildKernel {
          meta = boardData;
          extraPatches = cfg.extraPatches;
          excludePatchPatterns = cfg.excludePatchPatterns;
          configMode = effectiveConfigMode;
          extraConfig = cfg.extraConfig;
        }
      )
    );

    # 2. Basic Metadata info
    hardware.deviceTree.name = lib.mkDefault (boardData.dtb or (boardData.kernel.config or null));

    # 3. Bootloader Logic
    # We use extlinux for standardisation across all boards
    boot.loader.grub.enable = false;
    boot.loader.generic-extlinux-compatible.enable = true;

    # 4. Filesystem Support
    # Default to flash-friendly filesystems, but allow user overrides by avoiding mkForce
    boot.supportedFilesystems = [
      "vfat"
      "ext4"
      "btrfs"
      "f2fs"
    ];

    # 4b. SD Card Wear Mitigation
    boot.tmp.useTmpfs = lib.mkIf cfg.sdCard.wearMitigation.enable (lib.mkDefault true);
    services.journald.extraConfig = lib.mkIf cfg.sdCard.wearMitigation.enable (
      lib.mkDefault "Storage=volatile"
    );
    zramSwap.enable = lib.mkIf cfg.sdCard.wearMitigation.enable (lib.mkDefault true);

    # 4c. Security Hardening
    boot.kernel.sysctl = lib.mkIf cfg.security.harden {
      "net.ipv4.conf.all.rp_filter" = 1;
      "net.ipv4.conf.default.rp_filter" = 1;
      "net.ipv4.conf.all.accept_source_route" = 0;
      "net.ipv4.conf.default.accept_source_route" = 0;
      "net.ipv4.conf.all.send_redirects" = 0;
      "net.ipv4.conf.default.send_redirects" = 0;
      "net.ipv4.tcp_syncookies" = 1;
      "net.ipv4.tcp_rfc1337" = 1;

      "kernel.dmesg_restrict" = 1;
      "kernel.kptr_restrict" = 2;
    };

    # 5. Kernel Parameters for Label-based booting
    boot.kernelParams = [
      "root=LABEL=nixos"
      "rootwait"
      "console=ttyS0,115200"
      "console=tty1"
    ]
    ++ (if boardData.kernel_params != null then [ boardData.kernel_params ] else [ ]);

    # 6. U-Boot Provider
    # Default to vendor (Armbian-extracted) package,
    # or upstream U-Boot from denx.de when useUpstream is enabled.
    # Can be overridden by setting hardware.nixbian.uBoot.package.
    hardware.nixbian.uBoot.package = lib.mkDefault (
      if cfg.uBoot.useUpstream then
        if boardData.uboot.config or null != null then
          helpers.buildUpstreamUBoot { defconfig = boardData.uboot.config; }
        else
          null
      else
        familyPackages.uBoots.${boardKey} or null
    );

    # 7. Firmware Integration
    hardware.enableRedistributableFirmware = lib.mkDefault true;
    hardware.firmware =
      let
        baseFirmware = familyPackages.firmwares.${boardKey} or (fwLib.forFamily family);
        dtbFile =
          if cfg.pruneFirmware && config.hardware.deviceTree.name != null then
            "${config.boot.kernelPackages.kernel}/dtbs/${config.hardware.deviceTree.name}"
          else
            null;
      in
      [
        (
          if (cfg.pruneFirmware || cfg.compressFirmware) then
            (fwLib.build {
              inherit family;
              srcs = [ baseFirmware ];
              copyAll = true;
              dtb = dtbFile;
              kernelConfig = if cfg.compressFirmware then config.boot.kernelPackages.kernel.configfile else null;
            })
          else
            baseFirmware
        )
      ];

    # 8. Device Tree & Overlays
    hardware.deviceTree.enable = lib.mkDefault true;
    hardware.deviceTree.overlays = cfg.overlays ++ i2cOverlay ++ spiOverlay;

    # 9. Declarative GPIO Pin Services
    systemd.services = lib.mapAttrs' (
      name: pinCfg:
      let
        serviceName = "nixbian-gpio-${name}";
      in
      lib.nameValuePair serviceName {
        description = "Nixbian GPIO Pin Configurator for ${name}";
        wantedBy = [ "multi-user.target" ];
        after = [ "sysinit.target" ];
        serviceConfig = {
          ExecStart = makeGpiosetCmd name pinCfg;
          Restart = "always";
          RestartSec = "5s";
        };
      }
    ) cfg.gpio.pins;
  };
}
